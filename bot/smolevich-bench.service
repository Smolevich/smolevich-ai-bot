[Unit]
Description=smolevich-ai-bot model benchmark: measure and publish the leaderboard
After=network-online.target
Wants=network-online.target
OnFailure=hetzner-unit-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/opt/smolevich-ai-bot/.env
# Same pipeline the Temporal workflow ran: measure, publish board and methodology, purge.
# set -e: a failed PUT must fail the unit so OnFailure alerts, not hide behind purge.
ExecStart=/bin/sh -ec '[ "$BOT_BENCHMARK_DISABLED" = "1" ] && exit 0; \
  /usr/local/bin/model-benchmark run --max-jobs 200; \
  if [ -n "$MODEL_LEADERBOARD_TOKEN" ]; then \
    /usr/local/bin/model-benchmark leaderboard --publish && \
    /usr/local/bin/model-benchmark leaderboard --publish-tasks; \
  fi; \
  /usr/local/bin/model-benchmark purge'
# A run past half an hour means something is stuck; the next slot must not inherit it.
TimeoutStartSec=1800
StandardOutput=append:/var/log/model-benchmark.log
StandardError=append:/var/log/model-benchmark.log
